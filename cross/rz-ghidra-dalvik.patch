+static std::string DalvikFlavorFromMagic(RzCore *core)
+{
+	ut8 magic[8] = {};
+	if(!core || !core->io || !rz_io_read_at_mapped(core->io, 0, magic, sizeof(magic)) ||
+		memcmp(magic, "dex\n", 4) != 0 || magic[7] != 0)
+		return "DEX_Base";
+
+	if(magic[4] < '0' || magic[4] > '9' || magic[5] < '0' || magic[5] > '9' ||
+		magic[6] < '0' || magic[6] > '9')
+		return "DEX_Base";
+	const int version = (magic[4] - '0') * 100 + (magic[5] - '0') * 10 + (magic[6] - '0');
+
+	switch(version) {
+	// 035 is shared by KitKat, Lollipop and Marshmallow. The magic cannot
+	// distinguish them; Marshmallow is the compatible superset and recognizes
+	// later valid opcodes which the KitKat language marks unused.
+	case 35: return "Marshmallow";
+	case 37: return "DEX_Nougat";
+	case 38: return "DEX_Oreo";
+	case 39: return "DEX_Pie";
+	case 40: return "DEX_Android10";
+	case 41: return "DEX_Android13";
+	default: return "DEX_Base";
+	}
+}
