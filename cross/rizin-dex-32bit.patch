+/*
+ * Dalvik Sleigh uses a 32-bit RAM space.  The old synthetic bases were above
+ * 4 GiB, so rz-ghidra wrapped every concrete method address and rejected the
+ * resulting function symbol as extending past the address space.  Keep the
+ * file-backed and relocation windows separate but representable by Dalvik.
+ * Hayabusa accepts DEX images up to 256 MiB, leaving a full 256 MiB gap before
+ * the relocation window.
+ */
+#define RZ_DEX_VIRT_ADDRESS  0x20000000
+#define RZ_DEX_RELOC_ADDRESS 0x40000000
 
